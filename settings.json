{
  "hooks": {
    "Notification": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$HOME/.config/iterm2/cc-status" } ] }
    ]
  },
  "model": "claude-opus-5-5",
  "enabledPlugins": {
    "remember@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "usage-meter@felix-mods": true,
    "task-progress@felix-mods": true,
    "next-steps@claude-community": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "felix-mods": {
      "source": {
        "source": "directory",
        "path": "/Users/felix/.claude/mods"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "language": "繁體中文",
  "theme": "auto"
}
