{
  "model": "claude-opus-5-5",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] && exec \"$f\"; true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] && exec \"$f\"; true"
          }
        ]
      }
