    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] && exec \"$f\"; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] && exec \"$f\"; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/iterm2/cc-status\"; [ -x \"$f\" ] && exec \"$f\"; true"
